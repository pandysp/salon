# Production config for `scripts/up.sh prod`: copy to infra/prod.env (gitignored, chmod 600) and fill in the values.
APP_ORIGIN=https://artifacts-app.<tailnet>.ts.net
CONTENT_ORIGIN=https://artifacts-usercontent.<tailnet>.ts.net
OWNER_LOGINS=<your-tailscale-login>
AGENT_TOKEN=<random secret, also given to pi as ARTIFACTS_AGENT_TOKEN>
TOKEN_KEY_FILE=<path to a 0600 file with `openssl rand -base64 32`>
