# Config for the LOCAL test stack (tests/ use the same values).
# Production: copy infra/prod.env.example to infra/prod.env and fill in the real values; prod.env is gitignored (it holds
# the agent token). Switching is a config change.
# Two origins on ONE site, like production (<tailnet>.ts.net): localtest.me is not on the Public Suffix List, and its public
# DNS answers 127.0.0.1 for every name (tests/support/global-setup.mjs refuses to run if it ever doesn't).
APP_ORIGIN=https://app.localtest.me:8340
CONTENT_ORIGIN=https://content.localtest.me:8340
OWNER_LOGINS=owner@test.example
# the owner's display name in the UI and MCP texts (optional, default "Owner"). Tests read it.
OWNER_NAME=Ada
AGENT_TOKEN=local-test-agent-token-not-a-secret
